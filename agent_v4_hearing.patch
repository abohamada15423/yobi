+class _LazyWhisper:
+    """v4: the Whisper wake model loads only when it's really needed (no
+    openWakeWord model) — otherwise the GPU stays free for the command STT."""
+
+    def __init__(self):
+        self._m = None
+        self._lock = threading.Lock()
+
+    def get(self):
+        with self._lock:
+            if self._m is None:
+                print_ar("🧠 جاري تحميل Whisper للنداء...")
+                self._m = _load_wake_model()
+            return self._m
+
+    def transcribe(self, *args, **kwargs):
+        return self.get().transcribe(*args, **kwargs)
+
+
+wake_model = _LazyWhisper()
